<cover-view wx:if="{{!hidden}}" class="tabbar">
  <cover-view wx:for="{{items}}" wx:key="pagePath" class="tab-item {{selected===index?'active':''}}" data-path="{{item.pagePath}}" data-index="{{index}}" bindtap="switchTab">
    <cover-view class="tab-icon">{{item.icon}}</cover-view>
    <cover-view class="tab-text">{{item.text}}</cover-view>
  </cover-view>
</cover-view>
