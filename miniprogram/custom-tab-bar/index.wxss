.tabbar {
  position: fixed;
  z-index: 1000;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 108rpx;
  padding: 10rpx 14rpx calc(10rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(25, 25, 25, .12);
  background: rgba(255, 255, 255, .96);
}

.tab-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 4rpx;
  border-radius: 14rpx;
  color: #77746e;
}

.tab-item.active {
  background: #191919;
  color: #fff;
}

.tab-icon { height: 34rpx; font-size: 27rpx; line-height: 34rpx; }
.tab-text { margin-top: 2rpx; font-size: 18rpx; line-height: 24rpx; }
