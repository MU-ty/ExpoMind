<view class="page"><view class="eyebrow">NEXT ACTION</view><view class="title">真实跟进记录</view><view class="muted">仅展示交流中实际保存的下一步行动</view><view wx:if="{{!tasks.length}}" class="empty">暂无跟进任务</view><view wx:for="{{tasks}}" wx:key="id" class="card"><view class="row between"><view class="name">{{item.contact_name}}</view><view class="date">{{item.date}}</view></view><view class="action">{{item.next_action}}</view><view class="muted summary">{{item.summary||'未记录摘要'}}</view><view class="company">{{item.company}}</view></view></view>
