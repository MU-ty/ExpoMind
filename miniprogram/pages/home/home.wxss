.metrics { display: flex; margin: 34rpx -6rpx 22rpx; }
.metrics .card { min-width: 0; flex: 1; margin: 0 6rpx; padding: 23rpx 18rpx; border-radius: 15rpx; }
.metrics text { display: block; min-height: 52rpx; color: #7d7972; font-size: 19rpx; line-height: 1.35; }
.metrics strong { display: block; margin-top: 10rpx; color: #191919; font-family: Georgia, "Songti SC", serif; font-size: 42rpx; font-weight: 400; }
.action { display: flex; align-items: center; justify-content: space-between; }
.action-title { margin-bottom: 8rpx; font-size: 28rpx; font-weight: 600; }
.action .muted { font-size: 21rpx; line-height: 1.5; }
.action>text { color: #191919; font-family: Georgia, serif; font-size: 52rpx; font-weight: 400; }
.section-title { margin: 42rpx 0 18rpx; font-family: Georgia, "Songti SC", serif; font-size: 34rpx; font-weight: 400; }
.contact { display: flex; align-items: center; }
.avatar { display: flex; width: 72rpx; height: 72rpx; align-items: center; justify-content: center; margin-right: 20rpx; border-radius: 14rpx; background: #e8e6e1; color: #191919; font-size: 23rpx; }
.photo-avatar { display: block; flex: 0 0 auto; }
.grow { flex: 1; }
.small { margin-top: 8rpx; font-size: 21rpx; }
.contact .score { font-size: 30rpx; }
