.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin:30rpx 0}.metrics .card{padding:22rpx 16rpx}.metrics text{display:block;color:#7f91a4;font-size:20rpx}.metrics strong{display:block;font-size:40rpx;margin-top:12rpx}.action{display:flex;justify-content:space-between;align-items:center}.action-title{font-weight:700;margin-bottom:8rpx}.action>text{font-size:54rpx;color:#43e6cd}.section-title{font-weight:700;margin:38rpx 0 18rpx}.contact{display:flex;align-items:center}.avatar{width:74rpx;height:74rpx;border-radius:18rpx;background:#1b5260;display:flex;align-items:center;justify-content:center;margin-right:20rpx}.grow{flex:1}.small{font-size:22rpx;margin-top:8rpx}.score{font-size:28rpx}
