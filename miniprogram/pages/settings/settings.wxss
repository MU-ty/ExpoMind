.intro { margin-bottom: 34rpx; font-size: 23rpx; }

.profile-card { display: flex; align-items: center; padding: 26rpx; }
.monogram {
  display: flex;
  width: 82rpx;
  height: 82rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  background: #191919;
  color: #fff;
  font-family: Georgia, "Songti SC", serif;
  font-size: 34rpx;
}
.profile-main { min-width: 0; flex: 1; margin-left: 22rpx; }
.profile-name { font-size: 29rpx; font-weight: 600; }
.profile-email { overflow: hidden; margin-top: 7rpx; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.status { padding: 8rpx 12rpx; border-radius: 7rpx; background: #e9f4e7; color: #36733c; font-size: 19rpx; }

.section-label { margin: 36rpx 0 14rpx; color: #77746e; font-size: 19rpx; letter-spacing: 3rpx; }
.form-card { padding-bottom: 26rpx; }
.label { color: #514e49; font-size: 22rpx; }
.form-card .input { margin-top: 10rpx; background: #faf9f6; }
.form-card .last-input { margin-bottom: 26rpx; }

.info-card { padding: 8rpx 28rpx; }
.info-row { display: flex; min-height: 82rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid rgba(25, 25, 25, .08); font-size: 22rpx; }
.info-row:last-child { border-bottom: 0; }
.info-value { max-width: 430rpx; margin-left: 24rpx; overflow: hidden; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.endpoint { font-size: 19rpx; }

.logout { width: 100%; margin-top: 36rpx; }
.logout-note { margin: 16rpx 0 20rpx; font-size: 20rpx; text-align: center; }
