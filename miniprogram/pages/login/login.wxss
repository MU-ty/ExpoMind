.login {
  min-height: 100vh;
  padding: 80rpx 48rpx 60rpx;
  box-sizing: border-box;
  background: linear-gradient(165deg, #fff 0%, #f7f6f2 48%, #ece9e2 100%);
  color: #191919;
}

.logo {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 4rpx;
  background: #191919;
  color: #fff;
  font-family: Georgia, serif;
  font-size: 34rpx;
}

.brand { margin-top: 16rpx; font-size: 28rpx; font-weight: 600; letter-spacing: -1rpx; }

.hero {
  max-width: 650rpx;
  margin-top: 118rpx;
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 66rpx;
  font-weight: 400;
  letter-spacing: -3rpx;
  line-height: 1.08;
}

.hero text { display: block; color: #191919; }
.intro { margin: 32rpx 0 46rpx; font-size: 25rpx; line-height: 1.7; }
.login-btn { height: 92rpx; line-height: 92rpx; }

.status {
  padding: 24rpx;
  border: 1rpx solid rgba(25, 25, 25, .12);
  border-radius: 13rpx;
  background: rgba(255, 255, 255, .8);
  color: #77746e;
  text-align: center;
  font-size: 23rpx;
}

.status.warning { background: #f1f0ec; color: #5f5c57; }
.dev-login { margin-top: 34rpx; }

.divider { display: flex; align-items: center; margin: 30rpx 0; color: #8a8780; font-size: 20rpx; }
.divider::before, .divider::after { height: 1rpx; flex: 1; background: rgba(25, 25, 25, .12); content: ""; }
.divider text { padding: 0 18rpx; }
.field-label { margin: 20rpx 2rpx 4rpx; color: #77746e; font-size: 20rpx; }
.endpoint-input { margin-bottom: 12rpx; font-size: 22rpx; }
.endpoint-test { margin: 0 0 28rpx; border: 1rpx solid rgba(25, 25, 25, .12); border-radius: 12rpx; background: #fff; color: #191919; font-size: 21rpx; }
.endpoint-test::after { border: 0; }
.dev-login .btn { margin-top: 12rpx; }
.endpoint { margin-top: 22rpx; color: #8a8780; font-size: 18rpx; text-align: center; word-break: break-all; }
.terms { margin-top: 36rpx; color: #9a968f; font-size: 19rpx; line-height: 1.6; text-align: center; }
