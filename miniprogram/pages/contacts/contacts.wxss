.mini-btn {
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid rgba(25, 25, 25, .12);
  border-radius: 13rpx;
  background: #fff;
  color: #191919;
  font-size: 22rpx;
  font-weight: 500;
}

.mini-btn::after { border: 0; }
.name { color: #191919; font-size: 31rpx; font-weight: 600; }
.small { margin-top: 8rpx; color: #817d76; font-size: 21rpx; }
.contact-person { display: flex; min-width: 0; align-items: center; }
.contact-photo { width: 76rpx; height: 76rpx; flex: 0 0 auto; margin-right: 18rpx; border-radius: 13rpx; background: #e8e6e1; }
.contact-photo.placeholder { display: flex; align-items: center; justify-content: center; color: #191919; font-family: Georgia, serif; font-size: 28rpx; }
.actions { display: flex; justify-content: flex-end; margin-top: 22rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(25, 25, 25, .08); }
.actions button { margin: 0 0 0 12rpx; padding: 0 19rpx; border: 1rpx solid rgba(25, 25, 25, .12); border-radius: 10rpx; background: #fff; color: #5f5c57; font-size: 20rpx; }
.actions button::after { border: 0; }
.actions .delete { color: #963d42; }

.overlay {
  position: fixed;
  z-index: 2000;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(247, 246, 242, .84);
}

.sheet {
  position: relative;
  display: flex;
  height: 88vh;
  width: 100%;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  flex-direction: column;
  overflow: hidden;
  border-top: 1rpx solid rgba(25, 25, 25, .12);
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  box-shadow: 0 -24rpx 80rpx rgba(25, 25, 25, .1);
}

.sheet-head { flex: 0 0 auto; padding: 34rpx 0 22rpx; border-bottom: 1rpx solid rgba(25, 25, 25, .08); }
.sheet-title { font-family: Georgia, "Songti SC", serif; font-size: 40rpx; font-weight: 400; }
.sheet-head>text { padding: 0 6rpx 0 24rpx; color: #77746e; font-size: 48rpx; }
.form-scroll { width: 100%; height: calc(88vh - 232rpx); flex: 0 0 auto; }
.form-content { padding: 16rpx 6rpx 4rpx 0; }
.picker-input { display: flex; align-items: center; }
.summary-input { width: 100%; min-height: 140rpx; padding-top: 22rpx; box-sizing: border-box; }
.scroll-space { height: 130rpx; }
.sheet-footer { position: absolute; z-index: 4; right: 32rpx; bottom: calc(20rpx + env(safe-area-inset-bottom)); left: 32rpx; padding: 18rpx 0 0; border-top: 1rpx solid rgba(25, 25, 25, .08); background: #fff; }
.save-contact { width: 100%; margin: 0; }
