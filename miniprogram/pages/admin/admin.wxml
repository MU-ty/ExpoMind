<view class="page"><view class="eyebrow">ADMIN</view><view class="title">用户管理</view><view wx:if="{{!users.length}}" class="empty">没有可管理用户</view><view wx:for="{{users}}" wx:key="id" class="card"><view class="row between"><view><view class="name">{{item.name}}</view><view class="muted email">{{item.email}}</view></view><view class="status {{item.is_active?'active':'disabled'}}">{{item.is_active?'正常':'已禁用'}}</view></view><view class="row between meta"><text>{{item.contact_count}} 位联系人</text><text>{{item.role}}</text></view><view class="actions"><button size="mini" data-id="{{item.id}}" data-role="{{item.role}}" bindtap="role">{{item.role==='admin'?'降为用户':'设为管理员'}}</button><button size="mini" class="danger" data-id="{{item.id}}" data-active="{{item.is_active}}" bindtap="toggle">{{item.is_active?'禁用':'启用'}}</button></view></view><view class="section">审计日志</view><view wx:for="{{logs}}" wx:key="id" class="log"><view>{{item.actor}} · {{item.action}}</view><view class="muted">{{item.date}}</view></view></view>
