.name { color: #191919; font-size: 28rpx; font-weight: 600; }
.email { margin-top: 7rpx; color: #817d76; font-size: 20rpx; }
.status { padding: 6rpx 11rpx; border-radius: 99rpx; font-size: 19rpx; }
.active { background: #efeee9; color: #514e49; }
.disabled { background: #f7e8e8; color: #963d42; }
.meta { margin: 22rpx 0; color: #817d76; font-size: 21rpx; }
.actions { display: flex; justify-content: flex-end; padding-top: 16rpx; border-top: 1rpx solid rgba(25, 25, 25, .08); }
.actions button { margin: 0 0 0 12rpx; border: 1rpx solid rgba(25, 25, 25, .12); border-radius: 10rpx; background: #fff; color: #5f5c57; font-size: 20rpx; }
.actions button::after { border: 0; }
.actions .danger { color: #963d42; }
.section { margin: 44rpx 0 18rpx; font-family: Georgia, "Songti SC", serif; font-size: 36rpx; font-weight: 400; }
.log { padding: 22rpx 4rpx; border-bottom: 1rpx solid rgba(25, 25, 25, .08); color: #3a3834; font-size: 21rpx; }
.log .muted { margin-top: 6rpx; color: #8a8780; font-size: 18rpx; }
