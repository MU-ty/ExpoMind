.capture-page{background:#07111f;min-height:100vh}.camera,.camera-off{height:620rpx;width:100%;position:relative;background:radial-gradient(circle,#163445,#081522);display:flex;flex-direction:column;align-items:center;justify-content:center}.camera-off .btn{margin-top:30rpx;width:360rpx}.live{position:absolute;left:24rpx;top:24rpx;color:#ff6f78;background:rgba(4,12,22,.7);padding:12rpx 18rpx;border-radius:10rpx}.frame{position:absolute;width:370rpx;height:220rpx;border:3rpx solid #55dfce;left:190rpx;top:190rpx}.toolbar{height:120rpx;display:flex;align-items:center;justify-content:center;gap:54rpx;background:#091625}.tool{background:transparent;color:#8fa0b0;font-size:22rpx}.shutter{width:78rpx;height:78rpx;border-radius:50%;background:#edfafa;border:8rpx solid #23394a}.form-area{padding-top:24rpx}.consent{display:flex;gap:20rpx}.tiny{font-size:20rpx;margin-top:6rpx}.transcript,.next{box-sizing:border-box;width:100%;min-height:190rpx;background:#0a1726;border:1rpx solid rgba(255,255,255,.12);border-radius:16rpx;padding:22rpx;color:#fff;margin-bottom:18rpx}.summary{line-height:1.7;margin:20rpx 0}.score-row{margin-top:22rpx}.next{min-height:120rpx;margin-top:20rpx}
