page {
  min-height: 100%;
  background: #f7f6f2;
  color: #191919;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", Arial, sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 36rpx 30rpx 150rpx;
  box-sizing: border-box;
}

.eyebrow {
  margin-bottom: 12rpx;
  color: #77746e;
  font-size: 18rpx;
  font-weight: 500;
  letter-spacing: 5rpx;
  line-height: 1;
}

.title {
  margin: 0 0 12rpx;
  color: #191919;
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 54rpx;
  font-weight: 400;
  letter-spacing: -2rpx;
  line-height: 1.08;
}

.muted { color: #77746e; }

.card {
  margin-bottom: 18rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(25, 25, 25, .12);
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 16rpx 40rpx rgba(25, 25, 25, .035);
}

.btn {
  min-height: 88rpx;
  border: 1rpx solid #191919;
  border-radius: 14rpx;
  background: #191919;
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.btn::after { border: 0; }
.btn[disabled] { opacity: .48; }

.btn.secondary {
  border-color: rgba(25, 25, 25, .12);
  background: #fff;
  color: #191919;
}

.btn.danger {
  border-color: rgba(156, 63, 67, .2);
  background: #fff;
  color: #963d42;
}

.input {
  min-height: 86rpx;
  margin: 12rpx 0 22rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(25, 25, 25, .14);
  border-radius: 13rpx;
  background: #fff;
  color: #191919;
}

.input:focus { border-color: #191919; }

.row { display: flex; align-items: center; }
.between { justify-content: space-between; }

.tag {
  display: inline-block;
  margin: 8rpx 8rpx 0 0;
  padding: 8rpx 13rpx;
  border: 1rpx solid #dedcd6;
  border-radius: 8rpx;
  background: #efeee9;
  color: #514e49;
  font-size: 20rpx;
}

.empty {
  padding: 120rpx 30rpx;
  color: #87837c;
  text-align: center;
}

.score {
  color: #191919;
  font-family: Georgia, "Songti SC", serif;
  font-size: 40rpx;
  font-weight: 400;
}

.safe-bottom { height: 40rpx; }
