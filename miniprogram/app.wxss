page{background:#07111f;color:#eef5f7;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}.page{min-height:100vh;padding:32rpx;box-sizing:border-box}.eyebrow{font-size:20rpx;letter-spacing:4rpx;color:#43e6cd}.title{font-size:48rpx;font-weight:700;margin:12rpx 0}.muted{color:#7f91a4}.card{background:linear-gradient(145deg,#101f31,#0b1726);border:1rpx solid rgba(255,255,255,.09);border-radius:24rpx;padding:28rpx;margin-bottom:20rpx}.btn{background:linear-gradient(90deg,#43d8c6,#62e9d4);color:#071822;border:0;border-radius:16rpx;font-weight:700;font-size:28rpx}.btn::after{border:0}.btn.secondary{background:#112136;color:#9fb0bf;border:1rpx solid rgba(255,255,255,.1)}.btn.danger{background:#3a1821;color:#ff8993}.input{background:#0a1726;border:1rpx solid rgba(255,255,255,.12);border-radius:14rpx;padding:22rpx;margin:12rpx 0 22rpx;color:#fff}.row{display:flex;align-items:center}.between{justify-content:space-between}.tag{display:inline-block;color:#57dfce;background:rgba(67,230,205,.1);border-radius:8rpx;padding:7rpx 12rpx;margin:6rpx 8rpx 0 0;font-size:20rpx}.empty{text-align:center;color:#718397;padding:120rpx 30rpx}.score{font-size:40rpx;color:#55dfce;font-weight:700}.safe-bottom{height:40rpx}
